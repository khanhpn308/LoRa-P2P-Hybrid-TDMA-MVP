# LOCAL DEVELOPMENT TEMPLATE ONLY. NEVER COMMIT REAL SECRETS.
APP_ENV=development
POSTGRES_DB=lora_tdma
POSTGRES_USER=lora_local
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_LOCAL_PASSWORD
# Use require or verify-full for external PostgreSQL deployments.
POSTGRES_SSLMODE=disable
# Optional full DSN override (for managed/external PostgreSQL).
# DATABASE_URL=postgres://user:password@db.example.com:5432/lora_tdma?sslmode=verify-full

# Use mqtt-tls for Docker Compose (--profile tls), or localhost when running backend-go on host.
MQTT_HOST=mqtt-tls
MQTT_PORT=8883
MQTT_TLS_ENABLED=true
# Relative to deploy/ unless absolute. See deploy/README.md for provisioning.
MQTT_CERT_DIR=./secrets/broker
MQTT_BACKEND_CERT_DIR=./secrets/backend
# Client TLS paths inside the backend container (or local paths when running backend-go on host).
MQTT_TLS_CA_FILE=/run/secrets/mqtt/ca.crt
MQTT_TLS_CERT_FILE=/run/secrets/mqtt/backend.crt
MQTT_TLS_KEY_FILE=/run/secrets/mqtt/backend.key
# Optional TLS server name override and MQTT username/password authentication
# MQTT_TLS_SERVER_NAME=mqtt-tls
# MQTT_USERNAME=backend
# MQTT_PASSWORD=REPLACE_WITH_MQTT_PASSWORD

# Backend configuration
PORT=8080
BACKEND_PORT_BIND=127.0.0.1:8080
# Required in APP_ENV=production (>= 32 bytes, never default/placeholder values).
JWT_SECRET_KEY=REPLACE_WITH_STRONG_DEV_JWT_SECRET_KEY_MIN_32_BYTES
# Required in APP_ENV=production (64 hex chars or >= 32 bytes, non-zero).
DEVICE_PROVISION_MASTER_KEY=REPLACE_WITH_64_HEX_CHARS_OR_32_BYTE_MASTER_KEY

# Web Dashboard & Reverse Proxy configuration
WEB_PORT_BIND=127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
PROXY_CERT_DIR=./secrets/proxy
PROXY_HTTPS_BIND=127.0.0.1:443
