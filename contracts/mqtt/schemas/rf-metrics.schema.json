{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:rf-metrics:v1-draft",
  "title": "LoRa RF Metrics (V2 Gateway Uplink)",
  "description": "Versioned JSON MQTT contract for LoRa RF metrics published by Gateway (iot/v1/gw/{gateway_id}/uplink/rf-metrics). QoS1 non-retained. Governed by Issue #392.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "gateway_epoch"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0-draft"
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "gateway_epoch": {
      "type": "string",
      "format": "uuid",
      "description": "Unique boot epoch; regenerated on Gateway reboot, never on MQTT reconnect."
    },
    "sample_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal uint64 counter scoped to gateway_epoch; stable across replay."
    },
    "sample_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway-local monotonic microseconds at packet RxDone or channel sample."
    },
    "age_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Age of sample in milliseconds at publish time."
    },
    "kind": {
      "type": "string",
      "enum": [
        "NODE_UPLINK",
        "CHANNEL"
      ]
    },
    "channel_idx": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "VN920 channel index (0..10 per approved channel plan)."
    },
    "node_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254,
      "description": "Transmitting Node ID (for NODE_UPLINK)."
    },
    "rssi_dbm": {
      "type": "integer",
      "minimum": -200,
      "maximum": 0,
      "description": "Packet RSSI in dBm with HF offset -157 and nearest-integer rounding."
    },
    "snr_db": {
      "type": "number",
      "minimum": -50.0,
      "maximum": 50.0,
      "description": "Raw signed RegPktSnrValue / 4.0, preserving 0.25 dB resolution."
    },
    "source": {
      "type": "string",
      "enum": [
        "UP_EVENT",
        "UP_HEARTBEAT_ACK"
      ],
      "description": "Uplink packet type source."
    },
    "validation": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "UNVERIFIED_CRC_ONLY"
      ],
      "description": "Cryptographic authentication / integrity provenance."
    },
    "auth_provenance": {
      "type": "string",
      "enum": [
        "MIC_VERIFIED",
        "UNVERIFIED_CRC_ONLY",
        "UNVERIFIED"
      ],
      "description": "Cryptographic authentication provenance."
    },
    "channel_rssi_dbm": {
      "type": "integer",
      "minimum": -200,
      "maximum": 0,
      "description": "Instantaneous channel RSSI in dBm from RegRssiValue (HF offset -157)."
    },
    "sample_context": {
      "type": "string",
      "enum": [
        "RX_IDLE",
        "RX_ACTIVE"
      ],
      "description": "Receive state at sampling time (RX_ACTIVE if RegModemStat RxOnGoing, else RX_IDLE)."
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "description": "Batch of coalesced RF samples.",
      "items": {
        "$ref": "#/$defs/rf_sample"
      }
    }
  },
  "$defs": {
    "rf_sample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_seq",
        "sample_monotonic_us",
        "age_ms",
        "kind",
        "channel_idx"
      ],
      "properties": {
        "sample_seq": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "sample_monotonic_us": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,19})$"
        },
        "age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "NODE_UPLINK",
            "CHANNEL"
          ]
        },
        "channel_idx": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "node_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 254
        },
        "rssi_dbm": {
          "type": "integer",
          "minimum": -200,
          "maximum": 0
        },
        "snr_db": {
          "type": "number",
          "minimum": -50.0,
          "maximum": 50.0
        },
        "source": {
          "type": "string",
          "enum": [
            "UP_EVENT",
            "UP_HEARTBEAT_ACK"
          ]
        },
        "validation": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "UNVERIFIED_CRC_ONLY"
          ]
        },
        "auth_provenance": {
          "type": "string",
          "enum": [
            "MIC_VERIFIED",
            "UNVERIFIED_CRC_ONLY",
            "UNVERIFIED"
          ]
        },
        "channel_rssi_dbm": {
          "type": "integer",
          "minimum": -200,
          "maximum": 0
        },
        "sample_context": {
          "type": "string",
          "enum": [
            "RX_IDLE",
            "RX_ACTIVE"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "NODE_UPLINK"
              }
            }
          },
          "then": {
            "required": [
              "node_id",
              "rssi_dbm",
              "snr_db",
              "source"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "channel_rssi_dbm"
                  ]
                },
                {
                  "required": [
                    "sample_context"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CHANNEL"
              }
            }
          },
          "then": {
            "required": [
              "channel_rssi_dbm",
              "sample_context"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "node_id"
                  ]
                },
                {
                  "required": [
                    "rssi_dbm"
                  ]
                },
                {
                  "required": [
                    "snr_db"
                  ]
                },
                {
                  "required": [
                    "source"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "samples"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "kind"
            ]
          },
          {
            "required": [
              "sample_seq"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "sample_seq",
        "sample_monotonic_us",
        "age_ms",
        "kind",
        "channel_idx"
      ],
      "not": {
        "required": [
          "samples"
        ]
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "NODE_UPLINK"
              }
            }
          },
          "then": {
            "required": [
              "node_id",
              "rssi_dbm",
              "snr_db",
              "source"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "channel_rssi_dbm"
                  ]
                },
                {
                  "required": [
                    "sample_context"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CHANNEL"
              }
            }
          },
          "then": {
            "required": [
              "channel_rssi_dbm",
              "sample_context"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "node_id"
                  ]
                },
                {
                  "required": [
                    "rssi_dbm"
                  ]
                },
                {
                  "required": [
                    "snr_db"
                  ]
                },
                {
                  "required": [
                    "source"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
