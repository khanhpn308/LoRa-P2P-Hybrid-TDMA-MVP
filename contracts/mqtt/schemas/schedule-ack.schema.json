{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:schedule-ack:v1-draft",
  "title": "LoRa TDMA schedule-ack (active V2 contract)",
  "description": "Active V2 schedule acknowledgment contract. STAGE_ACK confirms durable staging; ACTIVE_REPORT confirms 100% affected nodes confirmed READY in Migration and local superframe switch executed; VERIFY_NACK reports rejection with reason_code.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{1,32}:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:(0|[1-9][0-9]{0,19})$",
      "description": "MUST equal gateway_id + ':' + gateway_epoch + ':' + event_seq (semantic equality validated by consumers). Stable on QoS1 retransmission/replay."
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "gateway_epoch": {
      "type": "string",
      "format": "uuid",
      "description": "Unique boot epoch; regenerate on Gateway reboot, never on MQTT reconnect. Offline queued events retain original epoch."
    },
    "event_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal uint64 counter scoped to gateway_epoch; semantic integer <= 18446744073709551615 and no wrap/reuse."
    },
    "observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event occurrence time (UTC Z) only when a defensible time source exists. Null when unknown; never silently backfill with ingest time."
    },
    "observed_time_source": {
      "enum": [
        "gateway_utc",
        "node_utc",
        "estimated",
        "unknown"
      ]
    },
    "radio_rx_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway-local monotonic microseconds; meaningful only within gateway_epoch. Do not compare across boots."
    },
    "buffered": {
      "type": "boolean",
      "description": "Indicates offline queue/replay path; QoS1 DUP flag is NOT a business dedup key. Event identity never changes after buffering."
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "schedule_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "stage": {
      "enum": [
        "STAGE_ACK",
        "VERIFY_NACK",
        "ACTIVE_REPORT"
      ],
      "description": "STAGE_ACK = durable staging only; ACTIVE_REPORT = gateway actually switched schedule at a superframe boundary; VERIFY_NACK = rejected."
    },
    "activate_at_superframe_seq": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ],
      "description": "Planned activation boundary, not evidence of actual activation."
    },
    "reason_code": {
      "enum": [
        "NONE",
        "BAD_SCHEMA",
        "BAD_AUTH",
        "BAD_VERSION",
        "STALE_VERSION",
        "EXPIRED",
        "OVERLAPPING_SLOT",
        "AIRTIME_LIMIT",
        "WRONG_GATEWAY",
        "UNSUPPORTED_PROFILE",
        "PERSIST_FAILED",
        "INSUFFICIENT_ANNOUNCEMENT_HORIZON",
        "INTERNAL_ERROR",
        "UNTRUSTED_CLOCK",
        "REPLAYED_REQUEST",
        "RETAINED_STALE",
        "INVALID_TIME_WINDOW"
      ]
    },
    "activated_at_superframe_seq": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        {
          "type": "null"
        }
      ],
      "description": "Required non-null on ACTIVE_REPORT; actual gateway-observed activation boundary, compared with planned boundary by Backend."
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "gateway_id",
    "gateway_epoch",
    "event_seq",
    "observed_at",
    "observed_time_source",
    "radio_rx_monotonic_us",
    "buffered",
    "request_id",
    "schedule_id",
    "schedule_version",
    "stage",
    "activate_at_superframe_seq",
    "reason_code"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "VERIFY_NACK"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "not": {
              "const": "NONE"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "STAGE_ACK",
              "ACTIVE_REPORT"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "activate_at_superframe_seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "observed_time_source": {
            "const": "unknown"
          }
        },
        "required": [
          "observed_time_source"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "STAGE_ACK",
              "ACTIVE_REPORT"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "ACTIVE_REPORT"
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "required": [
          "activated_at_superframe_seq"
        ],
        "properties": {
          "activated_at_superframe_seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "enum": [
              "STAGE_ACK",
              "VERIFY_NACK"
            ]
          }
        },
        "required": [
          "stage"
        ]
      },
      "then": {
        "properties": {
          "activated_at_superframe_seq": {
            "type": "null"
          }
        }
      }
    }
  ],
  "description": "DRAFT MQTT v1 payload; schema checks local shape, not topic authorization, replay, clock freshness, state transitions or MQTT properties. Cross-team review pending (Issue #14)."
}
