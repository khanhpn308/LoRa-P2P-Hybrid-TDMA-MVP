{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:session-key-ack:1.1-draft",
  "title": "Gateway session key installation acknowledgement (proposed MQTT 5.0 contract)",
  "description": "DRAFT schema; authenticated ACK is evidence from a trusted Gateway implementation, not independent proof of durable storage without implementation/HIL checks.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1-draft"
    },
    "ack_protocol_version": {
      "type": "integer",
      "const": 1
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$",
      "description": "Canonical MQTT gateway principal/topic identifier (e.g. gw01), not the 1-byte RF Gateway ID."
    },
    "install_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_revision": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$",
      "description": "Canonical uint64 decimal string; consumer MUST parse exactly and enforce <=18446744073709551615, no float/JS number conversion."
    },
    "wrap_key_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "status": {
      "enum": [
        "INSTALLED",
        "REJECTED"
      ]
    },
    "reason_code": {
      "enum": [
        "NONE",
        "BAD_SCHEMA",
        "WRONG_GATEWAY",
        "BAD_AUTH",
        "STALE_REVISION",
        "DUPLICATE_CONFLICT",
        "EXPIRED",
        "UNTRUSTED_CLOCK",
        "KEY_SLOT_CONFLICT",
        "PERSIST_FAILED",
        "UNSUPPORTED_CRYPTO",
        "REVOKED",
        "INTERNAL_ERROR"
      ]
    },
    "ack_tag": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4}){5}[A-Za-z0-9+/]{2}==$",
      "description": "Canonical RFC4648 Base64 of 16B truncated HMAC-SHA256 over canonical ACK transcript with domain-separated key; format alone cannot verify MAC."
    }
  },
  "required": [
    "schema_version",
    "ack_protocol_version",
    "gateway_id",
    "install_id",
    "session_id",
    "session_revision",
    "wrap_key_id",
    "status",
    "reason_code",
    "ack_tag"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "INSTALLED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "not": {
              "const": "NONE"
            }
          }
        }
      }
    }
  ]
}
