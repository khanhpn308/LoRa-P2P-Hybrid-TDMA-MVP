{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:command-ack:v1-draft",
  "title": "LoRa TDMA command-ack (proposed contract)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{1,32}:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:(0|[1-9][0-9]{0,19})$",
      "description": "MUST equal gateway_id + ':' + gateway_epoch + ':' + event_seq (semantic equality validated by consumers). Stable on QoS1 retransmission/replay."
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "gateway_epoch": {
      "type": "string",
      "format": "uuid",
      "description": "Unique boot epoch; regenerate on Gateway reboot, never on MQTT reconnect. Offline queued events retain original epoch."
    },
    "event_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal uint64 counter scoped to gateway_epoch; semantic integer <= 18446744073709551615 and no wrap/reuse."
    },
    "observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event occurrence time (UTC Z) only when a defensible time source exists. Null when unknown; never silently backfill with ingest time."
    },
    "observed_time_source": {
      "enum": [
        "gateway_utc",
        "node_utc",
        "estimated",
        "unknown"
      ]
    },
    "radio_rx_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway-local monotonic microseconds; meaningful only within gateway_epoch. Do not compare across boots."
    },
    "buffered": {
      "type": "boolean",
      "description": "Indicates offline queue/replay path; QoS1 DUP flag is NOT a business dedup key. Event identity never changes after buffering."
    },
    "command_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254
    },
    "status": {
      "enum": [
        "QUEUED",
        "DISPATCHED",
        "NODE_ACKED",
        "REJECTED",
        "EXPIRED",
        "UNKNOWN"
      ],
      "description": "NODE_ACKED only after verified node-level application ACK, not MQTT PUBACK or Gateway queueing."
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "NONE",
        "BAD_SCHEMA",
        "BAD_AUTH",
        "WRONG_GATEWAY",
        "EXPIRED",
        "STALE_COMMAND",
        "DUPLICATE_CONFLICT",
        "UNSUPPORTED_ACTION",
        "BAD_PARAMS",
        "AIRTIME_LIMIT",
        "NODE_NACK",
        "NODE_TIMEOUT",
        "UNTRUSTED_CLOCK",
        "INTERNAL_ERROR"
      ],
      "description": "Draft stable application-level codes, NOT MQTT 5 Reason Codes. For REJECTED/EXPIRED/UNKNOWN a non-NONE reason is mandatory."
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "gateway_id",
    "gateway_epoch",
    "event_seq",
    "observed_at",
    "observed_time_source",
    "radio_rx_monotonic_us",
    "buffered",
    "command_id",
    "node_id",
    "status",
    "reason_code"
  ],
  "description": "DRAFT MQTT v1 payload; schema checks local shape, not topic authorization, replay, clock freshness, state transitions or MQTT properties. Cross-team review pending (Issue #14).",
  "allOf": [
    {
      "if": {
        "properties": {
          "observed_time_source": {
            "const": "unknown"
          }
        },
        "required": [
          "observed_time_source"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "REJECTED",
              "EXPIRED",
              "UNKNOWN"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "not": {
              "const": "NONE"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "QUEUED",
              "DISPATCHED",
              "NODE_ACKED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "NONE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXPIRED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason_code": {
            "const": "EXPIRED"
          }
        }
      }
    }
  ]
}
