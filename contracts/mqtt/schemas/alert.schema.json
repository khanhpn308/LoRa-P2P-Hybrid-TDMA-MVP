{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:alert:v1-draft",
  "title": "LoRa TDMA alert (proposed contract)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Node-origin opaque logical Event ID (C05), stable across RF retry, MQTT QoS1 replay and Node/Gateway reboot. Uniqueness and dedup key scoped by (gateway_id, node_id, event_id); exact binary encoding/persistence pending G2."
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "gateway_epoch": {
      "type": "string",
      "format": "uuid",
      "description": "Gateway reception tracking: boot epoch, not origin identity of a sensor event; can differ on re-reception/reboot. Never derive business event_id from it."
    },
    "event_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway reception tracking sequence scoped to gateway_epoch, not Node Event ID or business dedup key."
    },
    "observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event occurrence time (UTC Z) only when a defensible time source exists. Null when unknown; never silently backfill with ingest time."
    },
    "observed_time_source": {
      "enum": [
        "gateway_utc",
        "node_utc",
        "estimated",
        "unknown"
      ]
    },
    "radio_rx_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway-local monotonic microseconds; meaningful only within gateway_epoch. Do not compare across boots."
    },
    "buffered": {
      "type": "boolean",
      "description": "Offline/replay path; keep Node event_id unchanged, even when Gateway reconnects/reboots. May preserve original gateway reception metadata."
    },
    "node_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254,
      "description": "Node ID in range 1..254, scoped to gateway_id (C06); authenticated source must match the provisioned mapping."
    },
    "superframe_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "seq_num": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "schedule_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "severity": {
      "enum": [
        "P0_EMERGENCY",
        "P1_HIGH",
        "P2_MEDIUM",
        "P3_NORMAL"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "sensor_status_mask",
        "ch1_raw",
        "ch2_raw",
        "ch3_raw",
        "battery_mv",
        "node_duty_permille"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "sensor_status_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ch1_raw": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "ch2_raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ch3_raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "battery_mv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "node_duty_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "observed_raw",
        "threshold_raw"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "observed_raw": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "threshold_raw": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "description": "Optional until authenticated Radio MAC alert payload encodes the channel/threshold; never invent trigger values."
    },
    "radio_ack_sent": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "gateway_id",
    "gateway_epoch",
    "event_seq",
    "observed_at",
    "observed_time_source",
    "radio_rx_monotonic_us",
    "buffered",
    "node_id",
    "superframe_seq",
    "seq_num",
    "schedule_version",
    "severity",
    "data",
    "radio_ack_sent"
  ],
  "description": "DRAFT contract aligned with G0 C05/C06: Node-origin event_id and Gateway reception metadata are different identities. No RF byte layout, crypto or event-ID format approved; semantic auth/dedup and implementation NOT_VERIFIED.",
  "allOf": [
    {
      "if": {
        "properties": {
          "observed_time_source": {
            "const": "unknown"
          }
        },
        "required": [
          "observed_time_source"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
