{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:alert:v1-draft",
  "title": "LoRa TDMA alert / event (active V2 contract)",
  "description": "Active V2 event plane contract for discrete event ingestion (mapping UP_EVENT 0x41 26B). Gateway publishes this record following durable local WAL commit and immediate same-slot radio ACK (DOWN_EVENT_ACK 0x42 19B, radio_ack_sent: true). RF ACK, MQTT PUBACK, and Backend PostgreSQL commit are distinct confirmation layers.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "type": "string"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{1,32}:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}:(0|[1-9][0-9]{0,19})$",
      "description": "MUST equal gateway_id + ':' + gateway_epoch + ':' + event_seq (semantic equality validated by consumers). Stable on QoS1 retransmission/replay."
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "gateway_epoch": {
      "type": "string",
      "format": "uuid",
      "description": "Unique boot epoch; regenerate on Gateway reboot, never on MQTT reconnect. Offline queued events retain original epoch."
    },
    "event_seq": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Decimal uint64 counter scoped to gateway_epoch; semantic integer <= 18446744073709551615 and no wrap/reuse."
    },
    "observed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Event occurrence time (UTC Z) only when a defensible time source exists. Null when unknown; never silently backfill with ingest time."
    },
    "observed_time_source": {
      "enum": [
        "gateway_utc",
        "node_utc",
        "estimated",
        "unknown"
      ]
    },
    "radio_rx_monotonic_us": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Gateway-local monotonic microseconds; meaningful only within gateway_epoch. Do not compare across boots."
    },
    "buffered": {
      "type": "boolean",
      "description": "Indicates offline queue/replay path; QoS1 DUP flag is NOT a business dedup key. Event identity never changes after buffering."
    },
    "node_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 254
    },
    "superframe_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "seq_num": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "schedule_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "severity": {
      "enum": [
        "P0_EMERGENCY",
        "P1_HIGH",
        "P2_MEDIUM",
        "P3_NORMAL"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "sensor_status_mask",
        "ch1_raw",
        "ch2_raw",
        "ch3_raw",
        "battery_mv",
        "node_duty_permille"
      ],
      "properties": {
        "slot_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15
        },
        "sensor_status_mask": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "ch1_raw": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "ch2_raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "ch3_raw": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "battery_mv": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "node_duty_permille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "observed_raw",
        "threshold_raw"
      ],
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "observed_raw": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "threshold_raw": {
          "type": "integer",
          "minimum": -2147483648,
          "maximum": 2147483647
        }
      },
      "description": "Optional until authenticated Radio MAC alert payload encodes the channel/threshold; never invent trigger values."
    },
    "radio_ack_sent": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "gateway_id",
    "gateway_epoch",
    "event_seq",
    "observed_at",
    "observed_time_source",
    "radio_rx_monotonic_us",
    "buffered",
    "node_id",
    "superframe_seq",
    "seq_num",
    "schedule_version",
    "severity",
    "data",
    "radio_ack_sent"
  ],
  "description": "DRAFT MQTT v1 payload; schema checks local shape, not topic authorization, replay, clock freshness, state transitions or MQTT properties. Cross-team review pending (Issue #14).",
  "allOf": [
    {
      "if": {
        "properties": {
          "observed_time_source": {
            "const": "unknown"
          }
        },
        "required": [
          "observed_time_source"
        ]
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "null"
          }
        }
      }
    }
  ]
}
