{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:loratdma:mqtt:schedule:v1-draft",
  "title": "LoRa TDMA schedule (proposed contract)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0-draft",
      "type": "string"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,32}$"
    },
    "schedule_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$"
    },
    "schedule_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "profile_id": {
      "const": "P-10S-15",
      "type": "string"
    },
    "superframe_ms": {
      "const": 10000,
      "type": "integer"
    },
    "min_announce_superframes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 30
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "slot_id",
          "offset_ms",
          "duration_ms"
        ],
        "properties": {
          "node_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          },
          "slot_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "offset_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "duration_ms": {
            "const": 400,
            "type": "integer"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "gateway_id",
    "schedule_id",
    "schedule_version",
    "created_at",
    "expires_at",
    "profile_id",
    "superframe_ms",
    "min_announce_superframes",
    "slots"
  ]
}
