menu "OLED SSD1306 Configuration"

    config OLED_SSD1306_ENABLE
        bool "Enable SSD1306 OLED Display"
        default y
        help
            Enable local 0.96-inch SSD1306 OLED display for Sensor Node event monitoring.

    config OLED_SSD1306_I2C_SDA_GPIO
        int "I2C SDA GPIO Pin"
        default 21
        range 0 33
        depends on OLED_SSD1306_ENABLE
        help
            ESP32 GPIO pin for I2C SDA signal. Default is GPIO 21.
            Must not conflict with SPI flash (6-11), SX1276 (5, 18, 19, 23, 26, 27),
            console UART0 (1, 3), or input-only pins (34-39).

    config OLED_SSD1306_I2C_SCL_GPIO
        int "I2C SCL GPIO Pin"
        default 22
        range 0 33
        depends on OLED_SSD1306_ENABLE
        help
            ESP32 GPIO pin for I2C SCL signal. Default is GPIO 22.
            Must not conflict with SPI flash (6-11), SX1276 (5, 18, 19, 23, 26, 27),
            console UART0 (1, 3), or input-only pins (34-39).

    config OLED_SSD1306_I2C_ADDRESS
        hex "SSD1306 I2C 7-bit Address (0x3C or 0x3D)"
        default 0x3C
        range 0x08 0x77
        depends on OLED_SSD1306_ENABLE
        help
            I2C slave address of SSD1306 OLED display (default 0x3C, alternative 0x3D).

    config OLED_SSD1306_I2C_PORT
        int "I2C Master Port Number (0 or 1)"
        default 0
        range 0 1
        depends on OLED_SSD1306_ENABLE
        help
            I2C controller port index.

    config OLED_SSD1306_I2C_SPEED_HZ
        int "I2C Clock Speed (Hz)"
        default 400000
        range 100000 400000
        depends on OLED_SSD1306_ENABLE
        help
            I2C clock frequency (100000 for standard mode, 400000 for fast mode).

    config OLED_SSD1306_I2C_TIMEOUT_MS
        int "I2C Transaction Timeout (ms)"
        default 100
        range 10 1000
        depends on OLED_SSD1306_ENABLE
        help
            Maximum time in milliseconds to wait for an I2C transaction before reporting timeout.

endmenu
