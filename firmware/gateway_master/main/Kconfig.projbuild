# Project-level configuration for Gateway Master

menu "Gateway Master Configuration"

    menu "Gateway Device Identity & Network"
        config GATEWAY_ID
            string "Gateway Identity"
            default "gw-a"
            help
                Canonical gateway identifier (e.g., gw-a, gw-b).
                Used for MQTT topics and client identity.

        config GATEWAY_TARGET_GW_ID
            int "Gateway Numeric Network ID (0..254)"
            default 1
            range 0 254
            help
                Numeric gateway network ID matching DOWN_SYNC_BEACON origin and unicast filtering.
    endmenu

    menu "WiFi Station Configuration"
        config GATEWAY_WIFI_SSID
            string "Gateway WiFi SSID"
            default "myssid"
            help
                SSID for the WiFi access point the Gateway connects to.

        config GATEWAY_WIFI_PASSWORD
            string "Gateway WiFi Password"
            default "mypassword"
            help
                WPA2 pre-shared key for WiFi access.

        config GATEWAY_WIFI_MAX_RETRY
            int "WiFi Maximum Fast Retries"
            default 5
            range 1 50
            help
                Initial rapid reconnect attempts before exponential backoff.
    endmenu

    menu "MQTT 5.0 Broker Configuration"
        config GATEWAY_BROKER_HOST
            string "MQTT Broker Host"
            default "192.168.1.10"
            help
                Mosquitto MQTT broker hostname or IP address.

        config GATEWAY_BROKER_PORT
            int "MQTT Broker Port"
            default 8883
            range 1 65535
            help
                Mosquitto MQTT broker TLS port (8883 for TLS, 1883 for plain).

        config GATEWAY_BROKER_URI
            string "MQTT Broker URI override"
            default ""
            help
                Optional full URI override (e.g. mqtts://192.168.1.10:8883).
                If empty, constructed from host and port.

        config GATEWAY_TRANSPORT_QUEUE_SIZE
            int "Outbound MQTT Event Queue Capacity"
            default 16
            range 4 128
            help
                Bounded FreeRTOS queue depth for decoupling TDMA radio loop from network.

        config GATEWAY_TRANSPORT_TASK_STACK_SIZE
            int "Transport Task Stack Size (bytes)"
            default 8192
            range 4096 32768
            help
                Stack size in bytes for the dedicated gateway transport task.
    endmenu

endmenu
