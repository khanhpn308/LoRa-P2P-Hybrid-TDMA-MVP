CONFIG_IDF_TARGET="esp32"

# Enable MQTT v5 support in the managed ESP-MQTT component (ADR-0002)
CONFIG_MQTT_PROTOCOL_5=y

# Enable mbedtls certificate bundle for TLS server verification
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# SX1276 Host RX buffer size (128 bytes to accommodate UP_JOIN_HELLO 68B and DOWN_JOIN_GRANT 66B)
CONFIG_SX1276_HOST_RX_BUFFER_SIZE=128
